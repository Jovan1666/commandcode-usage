# 测试用的 React 依赖（只有 client 组件测试和预览页需要）
**/.devdeps/
node_modules/

# 运行时产物
*.log
.DS_Store
Thumbs.db

# 本地校验用的临时目录
/tmp/

# dsh 的预览页构建产物（preview/build.mjs 生成，里面含本机绝对路径）
plugins/dsh/preview/index.html
docs/images/_*.html

# Grok 在 Windows 上的批处理包装（setup.mjs 生成，内容随 --rows 变）
plugins/grok/scripts/cc-usage.cmd
